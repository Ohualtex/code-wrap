{
  "manifest_version": 3,
  "name": "Code Wrap",
  "version": "0.1.0",
  "description": "Automatically wrap classic code blocks in ChatGPT, Gemini, and Claude without changing their text.",
  "permissions": ["storage", "offscreen"],
  "icons": {
    "16": "icons/wrap-on-16.png",
    "32": "icons/wrap-on-32.png",
    "48": "icons/wrap-on-48.png",
    "128": "icons/wrap-on-128.png"
  },
  "action": {
    "default_title": "Code Wrap: wrapping on. Click to turn off.",
    "default_icon": {
      "16": "icons/wrap-on-16.png",
      "32": "icons/wrap-on-32.png",
      "48": "icons/wrap-on-48.png",
      "128": "icons/wrap-on-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
